rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Skills certificates - only the owner can upload, ANO can read
    match /skills/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Achievements - only the owner can upload, ANO can read
    match /achievements/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Camps - only the owner can upload, ANO can read
    match /camps/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
