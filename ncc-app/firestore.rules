rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection — readable by any signed-in user, writable by owner only
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Cadets collection — readable by any signed-in user, writable by owner only
    match /cadets/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Evaluations — readable by any signed-in user, writable by ANO/admin (any authenticated)
    match /evaluations/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Achievements — readable by any signed-in user, writable by owner
    match /achievements/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Skills — readable by any signed-in user, writable by owner
    match /skills/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Camps — readable by any signed-in user, writable by any authenticated user
    match /camps/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Fallback: any signed-in user can read/write anything else
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}